{
  "name": "tablissng",
  "version": "1.8.0",
  "description": "A beautiful, customizable New Tab page. This is an actively maintained fork of the original Tabliss project.",
  "license": "GPL-3.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "author": {
    "name": "BookCatKid",
    "url": "https://github.com/BookCatKid"
  },
  "contributors": [
    {
      "name": "Joel Shepherd",
      "url": "https://github.com/joelshepherd"
    }
  ],
  "scripts": {
    "build": "pnpm run build:web",
    "build:prepare": "pnpm run translations compile",
    "build:chromium": "pnpm run build:prepare && cross-env NODE_ENV=production BUILD_TARGET=chromium rspack",
    "build:firefox": "pnpm run build:prepare && cross-env NODE_ENV=production BUILD_TARGET=firefox rspack",
    "build:safari": "pnpm run build:prepare && cross-env NODE_ENV=production BUILD_TARGET=safari rspack",
    "build:web": "pnpm run build:prepare && cross-env NODE_ENV=production BUILD_TARGET=web rspack",
    "dev": "pnpm run dev:web",
    "dev:chromium": "cross-env BUILD_TARGET=chromium rspack --watch",
    "dev:firefox": "cross-env BUILD_TARGET=firefox rspack --watch",
    "dev:safari": "cross-env BUILD_TARGET=safari rspack --watch",
    "dev:web": "cross-env BUILD_TARGET=web rspack serve",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "test": "tsc && rstest run",
    "test:e2e": "playwright test",
    "test:e2e:extension": "pnpm run build:chromium && playwright test --config playwright.extension.config.ts",
    "icons:generate": "node scripts/icons/generate.mjs",
    "translations": "node ./scripts/translations/translations.js",
    "sign:firefox": "node ./scripts/firefox-sign-manual.js",
    "sentry:sourcemaps": "node scripts/sentry-sourcemaps.mjs",
    "deps:check": "pnpm dlx npm-check",
    "deps:update": "pnpm dlx npm-check -u",
    "typecheck": "tsc",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "eslint --fix --cache",
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@sentry/browser": "10.74.0",
    "core-js": "^3.50.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.15",
    "in-browser-language": "^1.0.3",
    "nanoid": "^6.0.1",
    "normalize.css": "^8.0.1",
    "react": "^19.3.0",
    "react-activity-calendar": "^3.2.1",
    "react-crossfade-simple": "^1.0.7",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "react-github-btn": "^1.4.0",
    "react-github-calendar": "^5.0.9",
    "react-intl": "^10.1.17",
    "react-moveable": "^0.56.0",
    "tlds": "^1.261.0",
    "webextension-polyfill": "^0.12.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.19.1",
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "^6.16.30",
    "@playwright/test": "^1.63.0",
    "@rspack/cli": "2.2.6",
    "@rspack/core": "2.2.6",
    "@rspack/dev-server": "2.2.1",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@rstest/core": "^0.12.0",
    "@sentry/cli": "3.7.0",
    "@types/core-js": "~2.5.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-formatjs": "^8.0.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "sass": "^1.104.1",
    "sass-loader": "^17.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "workbox-build": "^7.4.1"
  },
  "engines": {
    "node": ">=24.0"
  }
}
